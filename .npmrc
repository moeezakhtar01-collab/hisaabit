# react-native-android-notification-listener@5 still declares its peer as
# react@^18, but this project is on react@19 (Expo SDK 54). That mismatch makes
# a clean `npm install` fail with ERESOLVE — including on EAS Build's
# "Install dependencies" phase. legacy-peer-deps relaxes peer resolution to the
# npm v6 behavior so the install succeeds everywhere (local, EAS, CI) without
# anyone needing to remember the --legacy-peer-deps flag.
legacy-peer-deps=true
