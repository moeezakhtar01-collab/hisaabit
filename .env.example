# ---------------------------------------------------------------------------
# Hisaabit environment variables
#
# Copy this file to `.env` for local development and fill in real values.
# In production (Railway), set these via the Railway dashboard, not a file.
# ---------------------------------------------------------------------------

# Postgres connection string.
# Local dev:  postgresql://postgres:postgres@localhost:5432/hisaabit
# Production: Neon pooled connection string with sslmode=require
DATABASE_URL=

# 64-byte random hex string used to sign session cookies.
# Generate locally with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# REQUIRED in production — server will refuse to start without it.
SESSION_SECRET=

# OpenAI API key — used for Whisper (Urdu transcription) + GPT-4o-mini
# (voice expense extraction). Get from https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Resend API key — used for email confirmation and password reset.
# Get from https://resend.com/api-keys
RESEND_API_KEY=

# `development` locally, `production` on Railway. Controls secure cookie flag
# and session secret enforcement.
NODE_ENV=development

# Port the Express server listens on. Railway sets this automatically.
PORT=5000

# Public URL of the Express API, used to build email confirmation links.
# Production example: https://hisaabit-api.up.railway.app
APP_URL=http://localhost:5000

# Public URL the Expo client uses for API calls. Prefixed with EXPO_PUBLIC_ so
# it gets inlined into the client bundle. Production builds (EAS) should set
# this to the Railway URL via EAS secrets.
EXPO_PUBLIC_DOMAIN=http://localhost:5000
